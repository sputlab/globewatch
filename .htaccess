# GlobeWatch — Apache settings for the site root (ignored by other servers: see README for nginx).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
  # Never serve dotfiles (.git, .htaccess…), docs, SQL or config templates
  <FilesMatch "(^\.|\.(md|sql|example|log|bak)$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git(/|$)
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Versioned assets (?v=…) can be cached for a year; the service worker, manifest and offline page must always be revalidated
  <FilesMatch "\.(css|js|svg|png|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
